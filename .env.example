# Copy to .env and fill in. Never commit .env.
# Not needed yet: the engine, narration and UI run without Azure.

# Microsoft Foundry (AI agents) — coming next
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_DEPLOYMENT=<deployment-name>

# Azure AI Speech (neural voices) — coming next
SPEECH_REGION=eastus2
SPEECH_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<resource>

# Cost guard: max matches with live AI commentary at once
MAX_AI_STREAMS=3

# Comma-separated origins allowed to call the API in development
CORS_ORIGINS=http://localhost:5173
